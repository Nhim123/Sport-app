{
  "expo": {
    "name": "Sportapp",
    "slug": "sportapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "sportapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sportapp.mobile"
    },
    "android": {
      "package": "com.sportapp.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f172a",
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      "expo-asset",
      [
        "expo-location",
        { "locationWhenInUsePermission": "Sportapp dùng vị trí để hiển thị sân gần bạn trên bản đồ." }
      ],
      [
        "expo-camera",
        { "cameraPermission": "Sportapp dùng camera để quét mã QR tham gia câu lạc bộ." }
      ]
    ]
  }
}
