{
  "expo": {
    "name": "Sportapp",
    "slug": "sportapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "sportapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sportapp.mobile"
    },
    "android": {
      "package": "com.sportapp.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f172a",
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser"
    ]
  }
}
